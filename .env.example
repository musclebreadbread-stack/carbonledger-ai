# Supabase
# Leave both public values empty for local demo mode. Fill both together when
# connecting a real project; a partial configuration is rejected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Examples:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Supabase Edge Functions (supabase/functions/) — set with `supabase secrets set`,
# not in Vercel. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into
# functions by the platform and must not be set by hand. See docs/edge-functions.md.
#
# HMAC key for supplier submission tokens. Rotating it invalidates every
# outstanding token, which is the only revocation mechanism there is.
SUPPLIER_PORTAL_TOKEN_SECRET=
# Shared secret pg_cron presents to the two scheduled functions.
EDGE_CRON_SECRET=
# Optional: where supplier reminder digests are POSTed. Unset means none are sent.
SUPPLIER_NOTIFICATION_WEBHOOK_URL=

# Demo sign-in
#
# Local development enables demo mode automatically when both Supabase public
# variables are empty. Set false to disable it locally. Production still fails
# closed unless this is exactly true *and* DEMO_SESSION_SECRET is at least 32
# bytes; do not enable it on a deployment that handles real data.
ENABLE_DEMO_MODE=
# HMAC key for the signed cookie that holds a test-account session. Set a random
# value whenever ENABLE_DEMO_MODE=true outside localhost.
DEMO_SESSION_SECRET=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CarbonLedger AI

# Optional: Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
