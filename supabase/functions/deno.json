{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.45.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["deno.ns", "dom"]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "useTabs": false,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "check": "deno check _shared tests supplier-intake target-progress-rollup supplier-request-reminders",
    "test": "deno test tests",
    "verify": "deno fmt --check . && deno lint . && deno task check && deno task test"
  }
}
